// =============================================================================
// Nextflow resource configuration for local execution
// =============================================================================
// Adapt the executor block to match your machine's available CPUs and RAM.
// The values below are set for a machine with 15 cores and 32 GB RAM,
// reserving 1 core and 4 GB for the operating system.
//
// maxForks = 3 means at most 3 processes run in parallel at any time,
// keeping peak memory usage within the available budget.
// =============================================================================

executor {
  name   = 'local'
  cpus   = 14
  memory = '28 GB'
}

process {
  // Override the pipeline's multiline shell directive (incompatible with NF 25.x)
  shell = ['/bin/bash', '-euo', 'pipefail']

  withName: '.*FASTQC.*' {
    cpus   = 2
    memory = 4.GB
    time   = '2h'
  }

  withName: '.*TRIMGALORE.*|.*CUTADAPT.*|.*TRIM.*' {
    cpus   = 4
    memory = 4.GB
    time   = '4h'
  }

  withName: '.*MAGECK_COUNT.*' {
    cpus   = 4
    memory = 8.GB
    time   = '12h'
  }

  withName: '.*MAGECK_TEST.*' {
    cpus   = 2
    memory = 4.GB
    time   = '4h'
  }

  // Max 3 processes in parallel to stay within RAM budget
  maxForks = 3
}
